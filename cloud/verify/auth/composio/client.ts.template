// Verification stand-in for convex/composio/client.ts: same exports, no Composio API key, links point at this deployment.
import { ConvexError } from 'convex/values';

const TOOLKIT_SLUG_PATTERN = /^[a-z0-9_]+$/i;
const LINK_LIFETIME_MS = 10 * 60_000;
export const FIXTURE_CONNECT_PATH = '/composio-fixture/connect';

export interface ComposioClient {
  createConnectLink(input: {tenantId: string; toolkit: string; callbackUrl: string}): Promise<{
    redirectUrl: string;
    connectedAccountId: string;
    expiresAt: number;
  }>;
  revokeConnection(connectedAccountId: string): Promise<void>;
}

export function normalizeToolkit(toolkit: string): string {
  if (!TOOLKIT_SLUG_PATTERN.test(toolkit)) throw new ConvexError('Toolkit slug must be letters, digits or _');
  return toolkit.toLowerCase();
}

export function composioFor(env: Record<string, string | undefined>): ComposioClient {
  const site = env.CONVEX_SITE_URL;
  if (!site) throw new Error('CONVEX_SITE_URL is not set');
  return {
    async createConnectLink({toolkit, callbackUrl}) {
      const connectedAccountId = `ca_fixture_${crypto.randomUUID()}`;
      const link = new URL(FIXTURE_CONNECT_PATH, site);
      link.search = new URLSearchParams({account: connectedAccountId, toolkit, callback: callbackUrl}).toString();
      return {redirectUrl: link.href, connectedAccountId, expiresAt: Date.now() + LINK_LIFETIME_MS};
    },
    async revokeConnection() {},
  };
}
