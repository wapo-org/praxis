{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "cd ../.. && npm ci",
  "buildCommand": "npm run build && rm -rf dist/public && mkdir dist/public && printf 'User-agent: *\\nDisallow: /\\n' > dist/public/robots.txt",
  "outputDirectory": "dist/public",
  "fluid": true,
  "functions": {
    "api/index.ts": {"maxDuration": 300, "memory": 1024}
  },
  "rewrites": [{"source": "/api/turn", "destination": "/api"}, {"source": "/(.*)", "destination": "/api"}]
}
