# Private configuration template. Copy to .env.deploy and fill locally; never commit that copy.
VERCEL_TOKEN=
VERCEL_ORG_ID=
VERCEL_API_PROJECT_ID=
VERCEL_WEB_PROJECT_ID=
CONVEX_DEPLOY_KEY=
PRAXIS_API_URL=
PRAXIS_WEB_ORIGINS=
PRAXIS_ENCRYPTION_KEYS=
BETTER_AUTH_SECRET=
CONVEX_URL=
PRAXIS_CONVEX_SERVER_TOKEN=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=
# Optional: PRAXIS_COOKIE_SAMESITE, PRAXIS_RUN_BUDGET_MS, PRAXIS_SYNC_STRATEGY
# Optional: GROQ_API_KEY, OPENAI_API_KEY, ANTHROPIC_API_KEY
# Numbered siblings: a platform key can have more keys from other accounts as NAME_2, NAME_3, ... (no gaps),
# e.g. GROQ_API_KEY_2. The API fails over to the next key when one is invalid, rate limited or out of quota.
# Set them in Vercel (and in Convex where the service is used from Convex) and redeploy; no code change.
# This script forwards only the unsuffixed name, so add NAME_2, NAME_3, ... in the dashboards.
# Smoke paid model calls require --with-llm and an OpenRouter key (the smoke user connects it as their own):
# SMOKE_OPENROUTER_KEY=
# SMOKE_OPENROUTER_MODEL=  # optional catalogue id; the default model otherwise

# Internal Convex-to-worker HMAC keys (32+ random characters; next is optional).
PRAXIS_TURN_CURRENT_SIGNING_KEY=
PRAXIS_TURN_NEXT_SIGNING_KEY=
