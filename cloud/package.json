{
  "name": "praxis-cloud",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22",
    "npm": ">=11"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "typecheck": "npm run -ws --if-present typecheck",
    "test": "vitest run --passWithNoTests",
    "check:rules": "node scripts/check-rules.mjs",
    "lint": "oxlint --deny-warnings",
    "dev:local": "npm run dev:local -w @praxis/api",
    "specs": "node scripts/specs.mjs",
    "bench": "vitest bench --run scripts/bench/search.bench.ts",
    "verify": "tsx packages/verify/src/cli.ts",
    "browser:check": "tsx packages/browser-cli/scripts/fixture-check.ts"
  },
  "devDependencies": {
    "@informalsystems/quint": "0.33.1",
    "@types/node": "^24.0.0",
    "fast-check": "4.10.2",
    "oxlint": "1.93.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.0"
  }
}
