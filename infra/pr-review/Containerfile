FROM docker.io/library/node:22-bookworm-slim
ENV PLAYWRIGHT_BROWSERS_PATH=/opt/ms-playwright PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1 TBH_CREDENTIAL_BACKEND=file XDG_CONFIG_HOME=/root/.config
RUN apt-get update && apt-get install -y --no-install-recommends bash ca-certificates curl git gh jq lsof procps python3 ripgrep xz-utils && rm -rf /var/lib/apt/lists/*
RUN npm install -g npm@11 && npx -y playwright@1.64.1 install chromium --with-deps && rm -rf /var/lib/apt/lists/*
RUN curl -fsSLo /tmp/muse-install.sh https://dev.meta.ai/install.sh && bash /tmp/muse-install.sh && rm /tmp/muse-install.sh && ln -s /root/.local/bin/muse /usr/local/bin/muse && muse --version
ARG SKILLS_COMMIT=bf0c7cd80abdbf7fe47b634978a7d1b4071f71a7
RUN git init -q /tmp/cursor-plugins && cd /tmp/cursor-plugins && git remote add origin https://github.com/cursor/plugins.git && git sparse-checkout set pstack/skills && git fetch -q --depth=1 --filter=blob:none origin "$SKILLS_COMMIT" && git checkout -q FETCH_HEAD && mv pstack/skills /opt/muse-skills && cd / && rm -rf /tmp/cursor-plugins

RUN mkdir -p /workspace

RUN npm install -g @openai/codex@0.170.0
# ffmpeg turns the hands-on recording into the contact sheet the Sol visual reviewer scores.
RUN apt-get update && apt-get install -y --no-install-recommends ffmpeg && rm -rf /var/lib/apt/lists/*
# The preview tools pin Playwright to the installed browsers, independent of the PR's own lockfile.
RUN mkdir -p /opt/review-tools && cd /opt/review-tools && npm init -y >/dev/null && npm install --no-audit --no-fund playwright@1.64.1
